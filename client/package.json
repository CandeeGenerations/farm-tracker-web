{
  "name": "farm-tracker-web-client",
  "version": "1.10.9",
  "private": true,
  "description": "Track your farm!",
  "homepage": "https://github.com/CandeeGenerations/farm-tracker#readme",
  "bugs": {
    "url": "https://github.com/CandeeGenerations/farm-tracker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:CandeeGenerations/farm-tracker.git"
  },
  "license": "MIT",
  "author": "Candee Generations <admin@candeegenerations.com>",
  "scripts": {
    "build": "NEXT_PUBLIC_APP_VERSION=$npm_package_version next build",
    "dev": "fnm use; phase run 'NEXT_PUBLIC_APP_VERSION=$npm_package_version next dev --webpack -p ${PORT-3000}'",
    "eslint": "eslint 'src/**/*.{ts,tsx}'",
    "fix": "pnpm run eslint && pnpm run prettier --cache",
    "preinstall": "npx only-allow pnpm",
    "pcheck": "npm-check -u -i '{@headlessui/react,date-fns,react-day-picker,tailwind-merge,tailwind-variants,tailwindcss}' && pnpm audit",
    "prettier": "prettier --cache --check --write --ignore-unknown .",
    "prettier:ci": "prettier --check .",
    "start": "fnm use; NEXT_PUBLIC_APP_VERSION=$npm_package_version next start"
  },
  "dependencies": {
    "@headlessui/react": "1.7.19",
    "@headlessui/tailwindcss": "^0.2.2",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.4.0",
    "@internationalized/date": "^3.12.2",
    "@radix-ui/react-popover": "^1.1.18",
    "@radix-ui/react-slot": "^1.3.0",
    "@react-aria/datepicker": "^3.17.1",
    "@react-stately/datepicker": "^3.17.1",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tremor/react": "^3.18.7",
    "avvvatars-react": "^0.4.2",
    "axios": "^1.18.1",
    "change-case-all": "^2.1.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.21",
    "lodash": "^4.17.23",
    "next-auth": "^4.24.14",
    "papaparse": "^5.5.4",
    "react-content-loader": "^7.1.2",
    "react-day-picker": "8.10.2",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.80.0",
    "react-popper-tooltip": "^4.4.2",
    "react-tagsinput": "^3.20.3",
    "tailwind-merge": "2.6.1",
    "tailwind-variants": "^1.0.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@netlify/plugin-nextjs": "^5.15.12",
    "@types/lodash": "^4.17.23",
    "@types/node": "^25.9.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-tagsinput": "^3.20.6",
    "autoprefixer": "^10.5.2",
    "eslint": "10.6.0",
    "globals": "^17.7.0",
    "next": "^16.2.9",
    "prettier": "^3.9.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  }
}
